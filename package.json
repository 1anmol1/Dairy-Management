{
  "name": "amrit-manage",
  "version": "1.0.0",
  "description": "Amrit Manage — SaaS Dairy Management Platform",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names \"API,WEB\" --prefix-colors \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "build": "npm install --prefix backend && npm install --prefix frontend && npm run build --prefix frontend",
    "seed": "npm run seed:superadmin --prefix backend",
    "start": "npm run start --prefix backend"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "morgan": "^1.10.0",
    "qrcode": "^1.5.3",
    "@whiskeysockets/baileys": "^6.7.9",
    "pino": "^9.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
